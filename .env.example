# Docker ビルド用ホスト UID/GID
# Linux ホストでは bind mount のファイル所有権を揃えるために必須。
# macOS は Docker Desktop が UID を吸収するため未設定でも動くが、明示推奨。
# make install が .env を自動生成するとき `id -u` / `id -g` の値を書き込む。
# 手動で書く場合: HOST_UID=$(id -u) / HOST_GID=$(id -g)
# 未設定時のデフォルトは 1000。
# HOST_UID=1000
# HOST_GID=1000

# MySQL
DB_ROOT_PASSWORD=root
DB_DATABASE=app_db        # ← プロジェクトに合わせて変更
DB_USERNAME=app
DB_PASSWORD=password
